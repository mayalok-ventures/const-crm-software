    {
      "name": "2. Lead Management & Custom Fields",
      "item": [
        {
          "name": "POST Create Lead — Valid Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Lead ID generated and stored', function () {",
                  "    var json = pm.response.json();",
                  "    var lead = json.lead || json;",
                  "    pm.expect(lead).to.have.property('_id');",
