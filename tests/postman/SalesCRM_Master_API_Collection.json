            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman QA Lead\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"test@example.com\",\n  \"stage\": \"new\",\n  \"budget\": \"₹75 Lakhs\",\n  \"propertyType\": \"3BHK Luxury\",\n  \"source\": \"Postman Automation\"\n}"
            },
