          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of leads', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.leads || json).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
