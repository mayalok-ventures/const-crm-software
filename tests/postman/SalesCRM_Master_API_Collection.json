                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('PAYMENT_FORGERY_DETECTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
