# =============================================================================
# Production Environment Variables for Sahyak CRM Backend (AppSail / Host)
# Target API Domain: https://api.sahyak.com
# =============================================================================

# Server Port & Runtime Mode
NODE_ENV=production
PORT=5000
# NOTE: If deploying to Zoho Catalyst AppSail, X_ZOHO_CATALYST_LISTEN_PORT is injected automatically by the platform.

# Background Workers Flag (set to 'true' for single-process container; set to 'false' if running separate crm-worker)
RUN_BACKGROUND_WORKERS=true

# Database (Production MongoDB Atlas Connection String with TLS)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-address>/mobile-crm?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://crm_app_user:CHANGE_ME_TO_STRONG_PASSWORD@cluster0.abcde.mongodb.net/mobile-crm?retryWrites=true&w=majority

# Cryptographic Secrets (Minimum 64 characters for JWT, 32 characters for AES Encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_RANDOM_64_CHAR_HEX_SECRET
INTEGRATION_ENCRYPTION_KEY=GENERATE_RANDOM_32_CHAR_HEX_SECRET

# Origins & Domains
ALLOWED_ORIGINS=https://app.sahyak.com,https://crm.sahyak.com
FRONTEND_URL=https://app.sahyak.com
BACKEND_URL=https://api.sahyak.com

# Meta Ads Lead Sync Integration
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_API_VERSION=v22.0
META_VERIFY_TOKEN=GENERATE_STRONG_META_WEBHOOK_VERIFY_TOKEN
META_REDIRECT_URI=https://api.sahyak.com/api/integrations/meta/oauth/callback

# Google Ads Lead Form Webhook & OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.sahyak.com/api/integrations/google/oauth/callback
GOOGLE_WEBHOOK_SECRET=GENERATE_STRONG_GOOGLE_WEBHOOK_KEY

# Razorpay Subscriptions & Payments
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Meta WhatsApp Cloud API (Optional - If using Official Cloud API)
META_WA_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
META_WA_ACCESS_TOKEN=YOUR_SYSTEM_USER_ACCESS_TOKEN
META_WA_BUSINESS_ACCOUNT_ID=YOUR_WABA_ID

# WhatsApp Baileys Rate Limiting & Auto-Reconnect Settings
WA_AUTO_RECONNECT=true
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@sahyak.com

# SMTP / Email Configuration (Optional)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@sahyak.com
SMTP_PASS=YOUR_ZOHO_MAIL_APP_PASSWORD
EMAIL_FROM="Sahyak CRM" <noreply@sahyak.com>
