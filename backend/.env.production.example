# =============================================================================
# Production Environment Variables for crm.coresetu.com
# =============================================================================

PORT=5000
NODE_ENV=production

# Database (Replace with your Production MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://username:password@cluster0.yourdomain.mongodb.net/crm_production?retryWrites=true&w=majority

# Security Keys (Generate strong random 64-char strings for production)
JWT_SECRET=production_jwt_secret_coresetu_crm_2026_super_secure
INTEGRATION_ENCRYPTION_KEY=production_aes256_encryption_key_coresetu_crm_2026_secure

# Production Domain URLs
FRONTEND_URL=https://crm.coresetu.com
BACKEND_URL=https://api.coresetu.com

# Meta Ads Integration Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=your_strong_meta_webhook_verify_token_2026
META_REDIRECT_URI=https://api.coresetu.com/api/integrations/meta/oauth/callback

# Google Ads Integration Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.coresetu.com/api/integrations/google/oauth/callback
GOOGLE_WEBHOOK_SECRET=your_google_webhook_lead_secret_2026

# WhatsApp & Anti-Ban Rate Limiter Settings
WA_AUTO_RECONNECT=true
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000
