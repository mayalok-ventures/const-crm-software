{
  "family": "crm-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::501421114752:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "crm-backend",
      "image": "501421114752.dkr.ecr.eu-north-1.amazonaws.com/crm-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "MONGO_URI",
          "value": "mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.j988j68.mongodb.net/mobile-crm?retryWrites=true&w=majority&appName=Cluster0"
        },
        {
          "name": "CLOUDINARY_URL",
          "value": "cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>"
        },
        {
          "name": "JWT_SECRET",
          "value": "<STRONG_JWT_SECRET_MIN_32_CHARS>"
        },
        {
          "name": "JWT_EXPIRE",
          "value": "30d"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "MAX_WA_SESSIONS",
          "value": "15"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "admin@sahyak.com"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "<ADMIN_SECURE_PASSWORD>"
        },
        {
          "name": "WA_BUSINESS_NUMBER",
          "value": "918796475107"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/crm-backend-task",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
