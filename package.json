{
  "name": "mobile-crm-workspace",
  "version": "2.2.0",
  "description": "SalesCRM Mobile-first Monorepo Workspace",
  "scripts": {
    "dev": "node run-dev.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "mongo": "node backend/start-local-mongo.js",
    "build": "cd frontend && npm install && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:api": "node scratch/run_master_qa_suite.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
